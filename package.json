{
  "name": "@minhezluv/google-flow-mcp",
  "version": "1.0.0",
  "description": "MCP server that generates images and Veo videos on Google Flow (flow.google.com) through browser automation",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "google-flow-mcp": "scripts/npx-entry.mjs",
    "google-flow-chrome": "scripts/ensure-flow-chrome.mjs"
  },
  "files": [
    "src/",
    "config/flow.config.example.json",
    "config/capabilities.json",
    "scripts/*.mjs"
  ],
  "mcpName": "io.github.minhezluv/google-flow",
  "keywords": ["mcp", "mcp-server", "google-flow", "veo", "nano-banana", "image-generation", "video-generation"],
  "author": "nqminh",
  "license": "MIT",
  "homepage": "https://github.com/minhezluv/Google-flow-mcp-generate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhezluv/Google-flow-mcp-generate.git"
  },
  "scripts": {
    "start": "node src/index.js",
    "daemon": "node src/daemon/main.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "playwright": "^1.61.1",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
